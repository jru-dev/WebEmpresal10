@model List<Habitacion>
@{ ViewData["Title"] = "Habitaciones"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Habitaciones</h2>
    <a class="btn btn-primary" asp-action="Create">Nueva habitación</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="idTipo" class="form-select" asp-items="ViewBag.Tipos">
            <option value="">-- Todos los tipos --</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary">Filtrar</button>
    </div>
</form>

<table class="table table-striped bg-white">
    <thead>
        <tr><th>Número</th><th>Piso</th><th>Tipo</th><th>Precio/noche</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var h in Model)
    {
        <tr>
            <td>@h.Numero</td>
            <td>@h.Piso</td>
            <td>@h.IdTipoHabitacionNavigation.Nombre</td>
            <td>S/ @h.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@h.IdHabitacion">Detalles</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@h.IdHabitacion">Editar</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@h.IdHabitacion">Eliminar</a>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="5" class="text-center text-muted">No hay habitaciones.</td></tr>
    }
    </tbody>
</table>
