<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Habitaciones" asp-action="Index">Hotel</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Habitaciones" asp-action="Index">Habitaciones</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Reservas" asp-action="Disponibles">Disponibilidad</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Reservas" asp-action="Index">Reservas</a></li>
            </ul>
        </div>
    </nav>

    <main class="container pb-4">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
</body>
</html>
